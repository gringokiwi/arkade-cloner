# ---- Secrets: `pnpm init:env` generates both into .env (mode 600). Back them up. ----
# The solver's Arkade wallet: its BTC inventory.
ARKADE_MNEMONIC=
# The solver's Base account: HTLC claimer and relayer of gasless locks. Needs a little ETH for gas.
EVM_PRIVATE_KEY=

# ---- Base ----
BASE_CHAIN_ID=8453
# Must serve eth_getLogs (mainnet.base.org does not). Use a dedicated provider in production.
BASE_RPC_URL=https://base-rpc.publicnode.com
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Written by `pnpm deploy:htlc`:
HTLC_ADDRESS=
HTLC_DEPLOY_BLOCK=
BASE_CONFIRMATIONS=3

# ---- Payout ----
PAYOUT_LIGHTNING_ADDRESS=gringo@walletofsatoshi.com
# Addresses a quote request may name instead (comma separated, or * for any).
# ALLOWED_LIGHTNING_ADDRESSES=gringo@walletofsatoshi.com

# ---- Pricing and limits ----
SPREAD_BPS=100
LIGHTNING_FEE_BPS=50
LIGHTNING_FEE_FLAT_SATS=10
MIN_PAYOUT_SATS=1000
MAX_PAYOUT_SATS=250000
INVENTORY_RESERVE_SATS=0
QUOTE_TTL_SECONDS=600
# PRICE_SOURCES=coinbase,kraken,coingecko
# PRICE_MIN_SOURCES=2

# ---- Arkade ----
# ARKADE_OPERATOR_URL=https://arkade.computer
# ARKADE_SOLVER_CARD=./my-lightning-solver.card.json

# ---- Server ----
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
# Rehearse everything except funding the Arkade payment; declined orders are handed back.
DRY_RUN=false

# ---- Payer tools only (`pnpm pay`, `pnpm refund`) ----
# PAYER_PRIVATE_KEY=
# SOLVER_URL=http://127.0.0.1:8080
