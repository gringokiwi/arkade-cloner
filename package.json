{
  "name": "arkade-usdc-lightning-solver",
  "version": "0.1.0",
  "private": true,
  "description": "A solver that accepts USDC on Base, pays out of its BTC inventory within Arkade, and delivers it over Lightning to a Lightning address.",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "init:env": "tsx src/cli/init.ts",
    "status": "tsx src/cli/status.ts",
    "deploy:htlc": "tsx src/cli/deploy-htlc.ts",
    "pay": "tsx src/cli/pay.ts",
    "refund": "tsx src/cli/refund.ts",
    "topup": "tsx src/cli/topup.ts",
    "check:live": "tsx src/cli/check-live.ts",
    "compile:contract": "tsx scripts/compile-contract.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:fork": "FORK_URL=${FORK_URL:-https://mainnet.base.org} node --import tsx --test test/fork.test.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.6",
    "@arkade-os/solver-discovery": "0.3.0",
    "@arkade-os/swap": "0.1.6",
    "@scure/bip39": "2.4.0",
    "eventsource": "^5.1.5",
    "light-bolt11-decoder": "3.2.0",
    "nostr-tools": "2.24.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "hardhat": "2.29.2",
    "solc": "0.8.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
